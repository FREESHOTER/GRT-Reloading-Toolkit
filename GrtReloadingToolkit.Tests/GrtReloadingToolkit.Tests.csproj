<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GrtReloadingToolkit.Tests</RootNamespace>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- XlsxReader is plain net8.0, so a normal reference works. -->
    <ProjectReference Include="..\grt-plugins-shared\GrtPluginKit\GrtPluginKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ladder analyser is plain arithmetic that happens to live in the plugin project.
         That project is net8.0-windows and needs the Windows Desktop SDK, so referencing it
         would make these tests Windows-only. Linking the two files it actually needs keeps
         them runnable on any machine and on CI. -->
    <Compile Include="..\GrtReloadingToolkit\Ocw\LadderStep.cs" Link="Ocw\LadderStep.cs" />
    <Compile Include="..\GrtReloadingToolkit\Ocw\LadderAnalyzer.cs" Link="Ocw\LadderAnalyzer.cs" />
    <!-- Same story for the log store: SQLite and arithmetic, no WinForms. -->
    <Compile Include="..\GrtReloadingToolkit\Log\LogModels.cs" Link="Log\LogModels.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\Db.cs" Link="Log\Db.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\LoadSnapshot.cs" Link="Log\LoadSnapshot.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\BaBackfill.cs" Link="Log\BaBackfill.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\LoadScoring.cs" Link="Log\LoadScoring.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\LoadScoringConfig.cs" Link="Log\LoadScoringConfig.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\WorkflowRanking.cs" Link="Log\WorkflowRanking.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\LeaderboardRanking.cs" Link="Log\LeaderboardRanking.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\PowderCompare.cs" Link="Log\PowderCompare.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\AdvancedDiagnostics.cs" Link="Log\AdvancedDiagnostics.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\SessionTrend.cs" Link="Log\SessionTrend.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\PressureTrend.cs" Link="Log\PressureTrend.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\BaStaleness.cs" Link="Log\BaStaleness.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\BrassLife.cs" Link="Log\BrassLife.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\VelocityModel.cs" Link="Log\VelocityModel.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\Costing.cs" Link="Log\Costing.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\StockUnit.cs" Link="Log\StockUnit.cs" />
    <Compile Include="..\GrtReloadingToolkit\Log\Brands.cs" Link="Log\Brands.cs" />
    <!-- And for the brass-prep maths, which owns the length formatting the seating-depth
         tests assert on. -->
    <Compile Include="..\GrtReloadingToolkit\Brass\BrassCalc.cs" Link="Brass\BrassCalc.cs" />
    <Compile Include="..\GrtReloadingToolkit\Brass\SeatingForceCalc.cs" Link="Brass\SeatingForceCalc.cs" />
    <!-- And for the shot-group reader, which decides what unit an unlabelled reference
         distance is in. TargetGroup is its output type and lives next door. -->
    <Compile Include="..\GrtReloadingToolkit\Ocw\BallisticXCsv.cs" Link="Ocw\BallisticXCsv.cs" />
    <Compile Include="..\GrtReloadingToolkit\Ocw\GrtShotGroups.cs" Link="Ocw\GrtShotGroups.cs" />
    <!-- And for the card model, which decides what a printed card and its QR actually say.
         CardRenderer next door is GDI+ and stays out; LoadCard itself is plain data. -->
    <Compile Include="..\GrtReloadingToolkit\Cards\LoadCard.cs" Link="Cards\LoadCard.cs" />
    <!-- Same story for the label grid: RectangleF arithmetic deciding which labels land on which
         page. It is only geometry, so the paging invariant is testable off Windows. -->
    <Compile Include="..\GrtReloadingToolkit\Cards\LabelSheet.cs" Link="Cards\LabelSheet.cs" />
    <!-- Same story again: the chrono-statistics math is plain arithmetic, no WinForms. -->
    <Compile Include="..\GrtReloadingToolkit\ChronoStats\ChronoStatsCalc.cs" Link="ChronoStats\ChronoStatsCalc.cs" />
    <!-- The dbtest CLI self-test: no WinForms, just Console + Db. Linked so its path-safety
         invariant (never defaults to the real database) is covered by a test, not just eyeballed. -->
    <Compile Include="..\GrtReloadingToolkit\DbSelfTest.cs" Link="DbSelfTest.cs" />
  </ItemGroup>

</Project>

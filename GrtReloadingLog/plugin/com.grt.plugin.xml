<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<GordonsReloadingTool>

  <plugin
    name           = "Inventory &amp; Load Journal"
    id             = "com.grt.plugin.reloadinglog"
    version        = "0.1.0"
    provider       = "community"
    description    = "Component inventory (powder / primer / brass / bullet) with lot tracking, cost per round, and a load / range journal. 'Log from GRT' reads the open load and deducts stock."
    launch-windows = "GRT_Reloading_Log.exe"
    launch-type    = "onDemand"
    launch-args    = ""
    start-timeout  = "5.0"
    enabled        = "true"
  >

    <registerevent>
      <event name="ColorPresetChange" enabled="false" />
      <event name="TabSwitch" enabled="false" />
      <event name="TabComputed" enabled="false" />
      <event name="WindowClosed" enabled="false" />
    </registerevent>

    <menu autoenable="true" icon="media/icons/icn_log_16x16.png" icon_colorize="true">
      <menuitem id="open" label="Inventory &amp; Load Journal" enabled="true" checked="false"
                icon="media/icons/icn_log_16x16.png" />
    </menu>

    <toolbar>
      <toolbaritem
        id            = "toolbar_main"
        label         = "Inventory / Journal"
        tooltip       = "Component inventory, cost per round, and load journal"
        icon          = "media/icons/icn_log_32x32.png"
        icon_colorize = "true"
        enabled       = "true"
      />
    </toolbar>

  </plugin>
</GordonsReloadingTool>

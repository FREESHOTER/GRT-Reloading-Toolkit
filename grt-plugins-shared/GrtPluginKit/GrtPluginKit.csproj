<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GrtPluginKit</RootNamespace>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- So the tests can pin parsers against real fixtures without those parsers having to be
         part of the API plugins see. -->
    <InternalsVisibleTo Include="GrtReloadingToolkit.Tests" />
  </ItemGroup>

</Project>

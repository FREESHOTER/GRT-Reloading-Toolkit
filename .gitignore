# build output
bin/
obj/
artifacts/
dist/
*.user
*.suo
.vs/

# make-icons.ps1's old output folder — it now writes into GrtReloadingToolkit/plugin/media/icons/,
# which is committed. Kept so a stale local copy doesn't show up as untracked.
grt-plugins-shared/icons/

# ShotMarker's own web bundle. Nothing in the build reads it any more — the target faces are
# authored from the governing bodies' published dimensions in ShotMarkerCore/Faces/Tables — but
# it is ShotMarker's copyrighted code and this repo is public, so a local copy left over from
# before must never be committed.
fixtures/shotmarker/bundle/

# ShotMarker's device software package (server.js, server_shot.js, the web bundle…), which is
# where that bundle came from. Same reason: copyrighted, public repo.
SM_software_*.tar

# Screenshots are a local scratch area for issue/PR attachments, never part of the plugin.
screenshots/

# local
*.zip

# personal notes and drafts (never part of the repository)
note/

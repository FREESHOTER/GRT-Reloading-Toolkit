<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ShotMarker.Core</RootNamespace>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\grt-plugins-shared\GrtPluginKit\GrtPluginKit.csproj" />
  </ItemGroup>

  <!-- This project is plain net8.0 on purpose, exactly like GrtPluginKit: the readers, the
       target projection and the renderer are arithmetic over a file, so they stay buildable
       and testable on macOS and Linux. GrtReloadingToolkit (net8.0-windows) references it for
       the one WinForms window, Ui/ImportForm.cs.

       It deliberately compiles NO file out of GrtReloadingToolkit. As a standalone plugin it
       linked Ocw\BallisticXCsv.cs and Ocw\GrtShotGroups.cs to ask GRT's own reader which unit
       an unlabelled reference distance was in; v0.2.20 settled that question — GRT always
       stores millimetres and metres — so nothing here needs them any more. GrtShotGroups
       survives as the round-trip test's independent oracle, and that test now lives in
       GrtReloadingToolkit.Tests, which already links both files. One definition, no copies:
       a second copy of either is exactly how a group comes to look right and measure wrong. -->

  <ItemGroup>
    <!-- Generated by tools/extract-targetfaces.js from the archived bundle in
         fixtures/shotmarker/bundle. Committed so a build needs no Node. -->
    <EmbeddedResource Include="Faces\targetfaces.json" LogicalName="ShotMarker.Core.Faces.targetfaces.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Helvetica is a macOS font and does not exist on Windows, where GRT actually runs —
         SkiaSharp silently substituted some other face there. Liberation Sans is
         metric-compatible with Helvetica/Arial and is embedded so the render is
         byte-identical on every machine. The .txt files (licence, authors) stay out of the
         assembly; they just live in the repo as the licence obligation. -->
    <EmbeddedResource Include="Render\Fonts\LiberationSans-Regular.ttf" LogicalName="ShotMarker.Core.Render.Fonts.LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Render\Fonts\LiberationSans-Bold.ttf" LogicalName="ShotMarker.Core.Render.Fonts.LiberationSans-Bold.ttf" />
  </ItemGroup>

</Project>

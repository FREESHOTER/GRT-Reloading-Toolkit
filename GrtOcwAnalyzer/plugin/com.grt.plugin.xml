<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<GordonsReloadingTool>

  <plugin
    name           = "Ladder / OCW Analyzer"
    id             = "com.grt.plugin.ocwanalyzer"
    version        = "0.1.0"
    provider       = "community"
    description    = "Analyses a charge ladder (Athlon Rangecraft velocities + Ballistic-X target coordinates) for the velocity flat-spot and the OCW / Audette vertical-POI node, and writes an OCW note into the load."
    launch-windows = "GRT_OCW_Analyzer.exe"
    launch-type    = "onDemand"
    launch-args    = ""
    start-timeout  = "5.0"
    enabled        = "true"
  >

    <registerevent>
      <event name="ColorPresetChange" enabled="false" />
      <event name="TabSwitch" enabled="false" />
      <event name="TabDataChange" enabled="false" />
      <event name="TabComputed" enabled="false" />
      <event name="WindowClosed" enabled="false" />
    </registerevent>

    <menu autoenable="true" icon="media/icons/icn_ocw_16x16.png" icon_colorize="true">
      <menuitem id="open" label="Ladder / OCW Analyzer" enabled="true" checked="false"
                icon="media/icons/icn_ocw_16x16.png" />
    </menu>

    <toolbar>
      <toolbaritem
        id            = "toolbar_main"
        label         = "OCW Analyzer"
        tooltip       = "Charge ladder: velocity flat-spot + OCW vertical-POI node"
        icon          = "media/icons/icn_ocw_32x32.png"
        icon_colorize = "true"
        enabled       = "true"
      />
    </toolbar>

  </plugin>
</GordonsReloadingTool>

<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<GordonsReloadingTool>
  <!-- version is stamped from Directory.Build.props by build-plugin.ps1 when it assembles dist\;
       the literal below is what a hand-copied plugin folder reports, so keep the two in step. -->

  <plugin
    name           = "Reloading Toolkit"
    id             = "com.grt.plugin.reloadingtoolkit"
    version        = "0.2.4"
    provider       = "community"
    description    = "Reloading tools in one window: Athlon Rangecraft chrono import, Chronograph statistics, Ladder / OCW analyzer, Seating-depth analyzer, barrel calibration (Ba, or Ba+a0 shape fit), powder temp-coefficient fitter, brass prep (case volume + neck tension), seating force estimate (QC), load card / label, component inventory + load journal (cost per round, environment, calibrated Ba/a0, best-Ba search), and installable GRT report templates."
    launch-windows = "GRT_Reloading_Toolkit.exe"
    launch-type    = "onDemand"
    launch-args    = ""
    start-timeout  = "5.0"
    enabled        = "true"
  >

    <registerevent>
      <event name="ColorPresetChange" enabled="false" />
      <event name="TabSwitch" enabled="false" />
      <event name="TabDataChange" enabled="false" />
      <event name="TabComputed" enabled="false" />
      <event name="WindowClosed" enabled="false" />
    </registerevent>

    <!-- icon_colorize="false" everywhere the icon appears: it now ships in colour rather than as
         white line art for GRT to tint. GRT does not tint in the plugin dropdown, so the white
         version was white on a white menu and invisible there. -->
    <menu autoenable="true" icon="media/icons/icn_toolkit_16x16.png" icon_colorize="false">
      <menuitem id="open" label="Reloading Toolkit…" enabled="true" icon="media/icons/icn_toolkit_16x16.png" icon_colorize="false" />
    </menu>

    <toolbar>
      <toolbaritem id="open" label="Reloading Toolkit"
                   tooltip="Open the Reloading Toolkit: chrono import, ladder / seating / calibration analysis, brass prep, load cards, inventory"
                   icon="media/icons/icn_toolkit_32x32.png" icon_colorize="false" enabled="true" />
    </toolbar>

  </plugin>
</GordonsReloadingTool>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GRT_Reloading_Toolkit</AssemblyName>
    <RootNamespace>GrtReloadingToolkit</RootNamespace>
    <!-- DPI awareness is set by app.manifest (dpiAware=false), applied by the OS loader before
         any managed code runs. The tool windows use hand-coded pixel layout; letting Windows
         bitmap-scale each window is proportionally correct at any scale (slightly soft above
         100%). Do NOT also set ApplicationHighDpiMode here — WinForms warns WFAC010 and the two
         paths fight. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsFormsHighDpiAutoResizing>false</EnableWindowsFormsHighDpiAutoResizing>
    <!-- WFAC010 fires because the manifest carries dpiAware; that is deliberate and there is no
         ApplicationHighDpiMode to conflict with it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\grt-plugins-shared\GrtPluginKit\GrtPluginKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin template (manifest + icons) lands in the output under plugin\, which is what
         build-plugin.ps1's Assemble strips before laying down the stamped copy at the folder root.
         This item carried LinkBase="_plugin_template\" from the first commit and it never did
         anything: MSBuild synthesizes Link from LinkBase only in AssignLinkMetadata, which is
         gated on SynthesizeLinkMetadata (never set) and skips items whose DefiningProjectFullPath
         is the project itself — as this one's is. Do NOT re-add it. It described a layout that has
         never existed, and reading it as real is how you conclude Assemble strips the wrong
         folder on Windows. -->
    <None Include="plugin\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

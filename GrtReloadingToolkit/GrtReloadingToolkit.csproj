<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GRT_Reloading_Toolkit</AssemblyName>
    <RootNamespace>GrtReloadingToolkit</RootNamespace>
    <!-- DPI awareness is set by app.manifest (dpiAware=false), applied by the OS loader before
         any managed code runs. The tool windows use hand-coded pixel layout; letting Windows
         bitmap-scale each window is proportionally correct at any scale (slightly soft above
         100%). Do NOT also set ApplicationHighDpiMode here — WinForms warns WFAC010 and the two
         paths fight. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Puts an icon in the exe's Win32 resources, which is what Explorer, the Start menu and
         shortcuts read. It does NOT reach the title bar or the taskbar: those follow the
         *window's* icon, and WinForms defaults that to a stock glyph baked into
         System.Windows.Forms.dll regardless of what the exe carries. Ui\AppIcon.cs assigns it;
         see the comment there. app.ico is generated by grt-plugins-shared\make-icons.ps1 -Ico
         from the same drawing as the plugin icons. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableWindowsFormsHighDpiAutoResizing>false</EnableWindowsFormsHighDpiAutoResizing>
    <!-- WFAC010 fires because the manifest carries dpiAware; that is deliberate and there is no
         ApplicationHighDpiMode to conflict with it. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\grt-plugins-shared\GrtPluginKit\GrtPluginKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same file again, this time as a managed resource, so AppIcon can hand the whole
         multi-size .ico to Windows at runtime. ApplicationIcon above does not make it readable
         from managed code. LogicalName is spelled out because the default derives from
         RootNamespace, and renaming that would silently break the lookup instead of failing
         the build. -->
    <EmbeddedResource Include="app.ico" LogicalName="GrtReloadingToolkit.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="_plugin_template\" />
  </ItemGroup>

</Project>
